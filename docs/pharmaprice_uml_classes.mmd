    class ComparacaoPrecosResponse {
        <<Pydantic Schema>>
        +int medicamento_id
        +str produto
        +str substancia
        +str apresentacao
        +str uf
        +float pmc
        +List~ComparacaoPrecoItemResponse~ precos_encontrados
    }

    class MedicamentosRouter {
        <<APIRouter — app/api/medicamentos.py>>
        +buscar_medicamentos(q, uf, limit)
        +detalhar_medicamento(id)
        +listar_equivalentes(id, uf)
        +listar_historico_precos(id, uf)
        +criar_historico_preco(id, payload)
        +comparar_precos(id, uf)
    }

    note for Medicamento "Índices GIN pg_trgm em produto e substancia (migration d5e6f7a8b901)"

    Base <|-- Medicamento : herda
    Base <|-- HistoricoPreco : herda
    Medicamento "1" o-- "0..*" HistoricoPreco : historico_precos

    MedicamentosRouter ..> Medicamento : consulta via ORM
    MedicamentosRouter ..> HistoricoPreco : consulta/cria
    MedicamentosRouter ..> MedicamentoResumoResponse : serializa
    MedicamentosRouter ..> MedicamentoDetalheResponse : serializa
    MedicamentosRouter ..> HistoricoPrecoCreateRequest : recebe
    MedicamentosRouter ..> HistoricoPrecoResponse : serializa
    MedicamentosRouter ..> ComparacaoPrecosResponse : serializa
    ComparacaoPrecosResponse "1" o-- "0..*" ComparacaoPrecoItemResponse : precos_encontrados

    MainApp ..> MedicamentosRouter : inclui rotas
    MainApp ..> Settings : lê configuração
    MainApp ..> CmedPipeline : sincroniza no startup
    MainApp ..> Medicamento : consulta em /cmed/status
    CmedPipeline ..> Medicamento : upsert por codigo_ggrem
