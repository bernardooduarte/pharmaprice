    class Settings {
        <<pydantic BaseSettings — app/core/config.py>>
        +str database_url
        +str cors_origins
        +bool cmed_auto_sync
        +normalize_database_url()
    }

    class MainApp {
        <<FastAPI — app/main.py>>
        +dict cmed_sync_status
        +lifespan()
        +medir_tempo_requisicao(request, call_next)
        +health()
        +root()
        +cmed_status()
        -_sincronizar_cmed_em_background()
    }

    class CmedPipeline {
        <<módulo — app/cmed/pipeline.py>>
        +localizar_url_xlsx_atual(cliente)
        +baixar_xlsx_remoto(cliente, url)
        +parsear_xlsx(conteudo)
        +parsear_arquivo_local(caminho)
        +salvar_no_banco(session, medicamentos, ...)
        +atualizar_cmed_do_site(session)
    }

