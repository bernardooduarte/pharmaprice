    class HistoricoPreco {
        +int id
        +int medicamento_id
        +Decimal preco
        +Decimal pmc
        +str uf
        +str fonte
        +str tipo_fonte
        +datetime data_coleta
        +str observacao
        +datetime created_at
        +Medicamento medicamento
