# Banco de dados
DATABASE_URL=postgresql://pharmaprice:pharmaprice@localhost:5434/pharmaprice

# CMED — URL pública da tabela de preços (ANVISA)
CMED_URL=https://www.gov.br/anvisa/pt-br/assuntos/medicamentos/cmed/precos

# Sincroniza automaticamente com o site da CMED a cada startup do backend
CMED_AUTO_SYNC=true

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Scraping
SCRAPER_TIMEOUT_MS=30000
SCRAPER_HEADLESS=true

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
